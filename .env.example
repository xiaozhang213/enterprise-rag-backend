# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone
PINECONE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=enterprise-kb
# text-embedding-3-small outputs 1536 dimensions
PINECONE_DIMENSION=1536

# Retrieval
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# 留空则不启用鉴权(本地开发默认关闭；生产环境部署时务必设置一个真实值)
API_KEY=
QUERY_RATE_LIMIT=30/hour
INGEST_RATE_LIMIT=10/hour